# ============================================================
#  graph-mem configuration
#
#  Default below: fully local (Ollama in Docker, no API key).
#  Edit any line to switch — LLM and embedder are independent,
#  so you can mix local/remote freely.
#
#  Workflow (any mode):  docker compose up -d
# ============================================================

# --- LLM ---
# Three modes:
#   Docker Ollama (default):  http://ollama:11434/v1        (requires COMPOSE_PROFILES=ollama)
#   Host Ollama:              http://host.docker.internal:11434/v1  (Ollama running on your machine)
#   Remote (OpenRouter, …):   https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-dummy                   # remote: sk-or-v1-...
OPENAI_BASE_URL=http://ollama:11434/v1
MODEL_NAME=gemma3:4b                      # remote: google/gemma-3-4b-it

# --- Embedder (independent from LLM — can mix local/remote) ---
EMBEDDING_API_KEY=sk-dummy                # remote: sk-or-v1-...
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_MODEL_NAME=qwen3-embedding:4b   # remote: openai/text-embedding-3-small

# --- Infra ---
NEO4J_PASSWORD=graphiti
NEO4J_HTTP_PORT=7475                      # host port for Neo4j Browser (container always listens on 7474)
NEO4J_BOLT_PORT=7688                      # host port for Neo4j Bolt (container always listens on 7687)
GRAPHITI_PORT=8000                        # host port exposed for the Graphiti REST API
# GRAPHITI_TIMEOUT=60.0                    # HTTP timeout in seconds for Graphiti API calls
COMPOSE_PROFILES=ollama                   # set empty to skip the bundled Ollama container
