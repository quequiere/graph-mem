# ============================================================
#  graph-mem configuration
#
#  Default below: fully local (Ollama in Docker, no API key).
#  Edit any line to switch — LLM and embedder are independent,
#  so you can mix local/remote freely.
#
#  Workflow (any mode):  docker compose up -d
# ============================================================

# --- LLM ---
OPENAI_API_KEY=sk-dummy                   # remote: sk-or-v1-...
OPENAI_BASE_URL=http://ollama:11434/v1    # remote: https://openrouter.ai/api/v1
MODEL_NAME=gemma3:4b                      # remote: google/gemma-3-4b-it

# --- Embedder (independent from LLM — can mix local/remote) ---
EMBEDDING_API_KEY=sk-dummy                # remote: sk-or-v1-...
EMBEDDING_BASE_URL=http://ollama:11434/v1 # remote: https://openrouter.ai/api/v1
EMBEDDING_MODEL_NAME=nomic-embed-text     # remote: qwen/qwen3-embedding-8b

# --- Infra ---
NEO4J_PASSWORD=graphiti
COMPOSE_PROFILES=ollama                   # set empty to skip the bundled Ollama container
