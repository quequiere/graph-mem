# Hosted embeddings — routed through OpenRouter
# We only test models available on OR's /v1/embeddings endpoint (OpenAI,
# Gemini, BGE-M3, Qwen3-8B). Voyage / Cohere / Mistral are not on OR and
# would need direct API keys — out of scope for this run.
OPENROUTER_API_KEY=sk-or-v1-...

# Ollama endpoint (local phase)
OLLAMA_BASE_URL=http://127.0.0.1:11434
